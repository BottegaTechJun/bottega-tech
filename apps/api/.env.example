# Copy to apps/api/.env and fill in. Never commit the real key.
# Get a key at https://cala.ai
CALA_API_KEY=
VALKEY_URL=
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Matchup agent (POST /api/matchup). Off without a key.
GEMINI_API_KEY=
MATCHUP_MODEL=gemini-4-carbon
MATCHUP_MAX_STEPS=16

# Langfuse tracing. Off unless both keys are set. EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: project id from the Langfuse URL, enables session links in the UI
LANGFUSE_PROJECT_ID=
